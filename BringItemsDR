--==================================================
-- Bring Function
--==================================================

local function GetRoot()
	local Character = Player.Character

	if not Character then
		return nil
	end

	return Character:FindFirstChild("HumanoidRootPart")
end

local function BringModel(Model)
	if not Model
		or not Model.Parent
		or not Model:IsA("Model") then
		return
	end

	local Root = GetRoot()

	if not Root then
		return
	end

	-- المكان أمام اللاعب
	local TargetCFrame =
		Root.CFrame
		* CFrame.new(0, 0, -7)

	-- إذا كان للموديل PrimaryPart
	if Model.PrimaryPart then
		Model:PivotTo(TargetCFrame)
	else
		-- PivotTo يعمل حتى بدون PrimaryPart
		Model:PivotTo(TargetCFrame)
	end
end

--==================================================
-- Continuous Bring
--==================================================

local function StartBring()
	if Connections.Bring then
		Connections.Bring:Disconnect()
	end

	Connections.Bring = RunService.Heartbeat:Connect(function()

		if not BringEnabled then
			return
		end

		for Model, Selected in pairs(SelectedItems) do

			if Selected
				and Model
				and Model.Parent
				and Model:IsDescendantOf(ObjectModels) then

				BringModel(Model)

			end

		end
	end)
end

StartBring()

