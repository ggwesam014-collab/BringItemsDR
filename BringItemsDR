--==================================================
-- REMOVE ANCHOR
--==================================================

local function UnanchorModel(Model)

	for _, Object in ipairs(Model:GetDescendants()) do

		if Object:IsA("BasePart") then
			Object.Anchored = false
		end

	end
end

--==================================================
-- Bring
--==================================================

local function BringModel(Model)

	if not Model
		or not Model.Parent
		or not Model:IsDescendantOf(ObjectModels) then
		return
	end

	local Character = Player.Character

	if not Character then
		return
	end

	local Root = Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return
	end

	-- إزالة الـ Anchor قبل النقل
	UnanchorModel(Model)

	-- أمام اللاعب
	local Target = Root.CFrame * CFrame.new(0,0,-6)

	Model:PivotTo(Target)
end

--==================================================
-- Bring Loop
--==================================================

RunService.Heartbeat:Connect(function()

	if not BringEnabled then
		return
	end

	for Model, Selected in pairs(SelectedItems) do

		if Selected
			and Model
			and Model.Parent then

			BringModel(Model)

		end
	end
end)

