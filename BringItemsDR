--==================================================
-- Counter
--==================================================

local function UpdateCounter()
	local Count = 0

	for _, Value in pairs(SelectedItems) do
		if Value then
			Count += 1
		end
	end

	Counter.Text = Count .. " Selected"
end

--==================================================
-- Item Button
--==================================================

local function CreateItemButton(Model)

	if not Model:IsA("Model") then
		return
	end

	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1,-2,0,28)
	Button.BackgroundColor3 = Color3.fromRGB(36,36,43)
	Button.BorderSizePixel = 0
	Button.Text = Model.Name
	Button.TextColor3 = Color3.fromRGB(220,220,225)
	Button.TextSize = 11
	Button.Font = Enum.Font.GothamMedium
	Button.TextXAlignment = Enum.TextXAlignment.Left
	Button.AutoButtonColor = false
	Button.Parent = List

	local Pad = Instance.new("UIPadding")
	Pad.PaddingLeft = UDim.new(0,8)
	Pad.Parent = Button

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0,6)
	Corner.Parent = Button

	Button.MouseButton1Click:Connect(function()

		SelectedItems[Model] = not SelectedItems[Model]

		if SelectedItems[Model] then
			Button.BackgroundColor3 = Color3.fromRGB(40,125,70)
		else
			Button.BackgroundColor3 = Color3.fromRGB(36,36,43)
		end

		UpdateCounter()
	end)

	Model.AncestryChanged:Connect(function(_, Parent)

		if not Parent then
			SelectedItems[Model] = nil

			if Button then
				Button:Destroy()
			end

			UpdateCounter()
		end

	end)
end

--==================================================
-- Refresh
--==================================================

local function RefreshItems()

	for _, Object in ipairs(List:GetChildren()) do
		if Object:IsA("TextButton") then
			Object:Destroy()
		end
	end

	local Query = string.lower(Search.Text)

	for _, Model in ipairs(ObjectModels:GetChildren()) do

		if Model:IsA("Model") then

			if Query == ""
				or string.find(string.lower(Model.Name), Query, 1, true) then

				CreateItemButton(Model)

			end
		end
	end

	task.wait()

	List.CanvasSize = UDim2.new(
		0,
		0,
		0,
		Layout.AbsoluteContentSize.Y + 10
	)
end

Search:GetPropertyChangedSignal("Text"):Connect(RefreshItems)

ObjectModels.ChildAdded:Connect(function()
	RefreshItems()
end)

ObjectModels.ChildRemoved:Connect(function(Model)
	SelectedItems[Model] = nil
	UpdateCounter()
	RefreshItems()
end)

RefreshItems()

