--==================================================
-- Update Counter
--==================================================

local function UpdateCounter()
	local Count = 0

	for _, Selected in pairs(SelectedItems) do
		if Selected then
			Count += 1
		end
	end

	Counter.Text = tostring(Count) .. " Selected"
end

--==================================================
-- Create Item Button
--==================================================

local function CreateItemButton(Model)
	if not Model:IsA("Model") then
		return
	end

	local Button = Instance.new("TextButton")
	Button.Name = Model.Name
	Button.Size = UDim2.new(1, -2, 0, 35)
	Button.BackgroundColor3 = Color3.fromRGB(35,35,42)
	Button.BorderSizePixel = 0
	Button.Text = Model.Name
	Button.TextColor3 = Color3.fromRGB(220,220,225)
	Button.TextSize = 13
	Button.Font = Enum.Font.GothamMedium
	Button.TextXAlignment = Enum.TextXAlignment.Left
	Button.AutoButtonColor = false
	Button.Parent = List

	local ButtonPadding = Instance.new("UIPadding")
	ButtonPadding.PaddingLeft = UDim.new(0,10)
	ButtonPadding.Parent = Button

	local ButtonCorner = Instance.new("UICorner")
	ButtonCorner.CornerRadius = UDim.new(0,7)
	ButtonCorner.Parent = Button

	Button.MouseButton1Click:Connect(function()

		SelectedItems[Model] = not SelectedItems[Model]

		if SelectedItems[Model] then
			Button.BackgroundColor3 = Color3.fromRGB(45,125,75)
			Button.TextColor3 = Color3.fromRGB(255,255,255)
		else
			Button.BackgroundColor3 = Color3.fromRGB(35,35,42)
			Button.TextColor3 = Color3.fromRGB(220,220,225)
		end

		UpdateCounter()
	end)

	Model.AncestryChanged:Connect(function(_, Parent)
		if not Parent then
			SelectedItems[Model] = nil
			Button:Destroy()
			UpdateCounter()
		end
	end)
end

--==================================================
-- Refresh Items
--==================================================

local function RefreshItems()
	for _, Object in ipairs(List:GetChildren()) do
		if Object:IsA("TextButton") then
			Object:Destroy()
		end
	end

	local SearchText = string.lower(Search.Text)

	for _, Model in ipairs(ObjectModels:GetChildren()) do
		if Model:IsA("Model") then

			if SearchText == ""
				or string.find(string.lower(Model.Name), SearchText, 1, true) then

				CreateItemButton(Model)
			end

		end
	end

	task.wait()

	List.CanvasSize = UDim2.new(
		0,
		0,
		0,
		Layout.AbsoluteContentSize.Y + 15
	)
end

Search:GetPropertyChangedSignal("Text"):Connect(RefreshItems)

ObjectModels.ChildAdded:Connect(function()
	RefreshItems()
end)

ObjectModels.ChildRemoved:Connect(function(Model)
	SelectedItems[Model] = nil
	UpdateCounter()
	RefreshItems()
end)

RefreshItems()

